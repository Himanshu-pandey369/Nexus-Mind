# Git and system
.git
.gitignore
.DS_Store
*.pem
*.key

# Dependencies
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Environment files with secrets (keep .env.example)
**/.env
**/.env.*
!**/.env.example

# Firebase service account key — never bundle into Docker images
**/serviceAccountKey.json

# Docker and Compose manifests
**/docker-compose*.yml
Dockerfile*
**/Dockerfile*

# Test, coverage, and temporary scripts
**/coverage/
**/dist/
**/.nyc_output/
**/*test*.*
*.log

# IDE / Editor
**/.vscode/
**/.idea/
