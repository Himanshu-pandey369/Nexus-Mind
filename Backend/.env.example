# ==============================================================================
# NexusMind Backend — All-in-One Container Environment Variables
# Used by Render Web Service and local multi-process execution via PM2.
# ==============================================================================

# Core Runtime Settings
NODE_ENV=production
PORT=8000
FRONTEND_URL=https://your-nexusmind-frontend.vercel.app
TRUST_PROXY=true
# COOKIE_DOMAIN=yourdomain.com # Optional: set if frontend and backend share a parent domain

# Redis Connection (Standardized across all services; Upstash Redis or managed Redis instance)
# Format: rediss://default:<password>@<host>:6379 (TLS) or redis://<host>:6379
REDIS_URL=rediss://default:your_redis_password@your-redis-instance.upstash.io:6379

# Inter-Service Authentication Secret
# Generate a strong 32-byte hex secret: openssl rand -hex 32
INTERNAL_SECRET=your_32_byte_internal_shared_secret_here

# MongoDB Database URIs (Can share a cluster with different database names or use single MONGODB_URI)
AUTH_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/auth?retryWrites=true&w=majority
CHAT_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chat?retryWrites=true&w=majority
PAYMENT_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/payment?retryWrites=true&w=majority
AGENT_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/agent?retryWrites=true&w=majority
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nexusmind?retryWrites=true&w=majority # Fallback URI if individual URIs not set

# Firebase Admin SDK Credentials (Method 1: Raw JSON string of serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com"}

# AI & LLM Providers
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
GOOGLE_API_KEY=AIzaSy_your_google_gemini_api_key_here
# GEMINI_MODEL=gemini-3.1-flash-lite # Optional: override Gemini vision model
TAVILY_API_KEY=tvly-your_tavily_search_api_key_here

# Cloudinary Storage (Images, PDF, and PPT generation)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=nexusmind/images
CLOUDINARY_GENERATED_FOLDER=nexusmind/generated-images
CLOUDINARY_PDFS_FOLDER=nexusmind/generated-pdfs
CLOUDINARY_PPTS_FOLDER=nexusmind/generated-presentations

# Cloudflare Workers AI (FLUX.1 Schnell image generation via Vision Agent)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Qdrant Cloud Vector Database (PDF RAG Agent)
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_COLLECTION=nexusmind_pdf_rag

# Razorpay Payment Gateway (Test or Live mode)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Optional: Gateway Rate Limiting Custom Configuration (defaults shown)
# RATE_LIMIT_GENERAL_WINDOW_MS=900000
# RATE_LIMIT_GENERAL_MAX=300
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=30
# RATE_LIMIT_AI_WINDOW_MS=60000
# RATE_LIMIT_AI_MAX=30
# RATE_LIMIT_UPLOAD_WINDOW_MS=60000
# RATE_LIMIT_UPLOAD_MAX=10
# RATE_LIMIT_PAYMENT_WINDOW_MS=900000
# RATE_LIMIT_PAYMENT_MAX=30
