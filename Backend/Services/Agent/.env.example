PORT=8083
GROQ_API_KEY=""
GOOGLE_API_KEY=""
# OpenRouter API key — used for the Coding Agent (DeepSeek model)
OPENROUTER_API_KEY=""
CHAT_SERVICE_URL=http://chat-service:8002
REDIS_URL=redis://redis:6379
# Tavily Search API key (required for Search Agent live web search)
TAVILY_API_KEY=""

# MongoDB URI (for image uploads and agent persistence)
MONGODB_URI=""

# Cloudinary credentials (required for Vision Agent image uploads and PDF Agent)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="nexusmind/images"

# Vision Agent — folder where AI-generated images are stored in Cloudinary
CLOUDINARY_GENERATED_FOLDER="nexusmind/generated-images"

# Cloudflare Workers AI credentials (required for Vision Agent image generation via FLUX.1 Schnell)
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"

# PDF Agent — folder where generated PDFs are stored in Cloudinary
CLOUDINARY_PDFS_FOLDER="nexusmind/generated-pdfs"

# PPT Agent — folder where generated presentations are stored in Cloudinary
CLOUDINARY_PPTS_FOLDER="nexusmind/generated-presentations"

# Auth & Credit Service URL and shared service-auth secret
AUTH_SERVICE_URL=http://auth-service:8001
INTERNAL_SECRET=""

# Qdrant Cloud Vector Database (for PDF RAG Agent)
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION="nexusmind_pdf_rag"

