# Payment Service Environment Variables
PORT=8003
NODE_ENV=production

# Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Internal Microservices Communication
AUTH_SERVICE_URL=http://auth-service:8001
INTERNAL_SECRET=your_shared_internal_secret_here

# Razorpay Test Mode Credentials (Backend Only - NEVER expose to client)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret (Configured in Razorpay Dashboard > Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
