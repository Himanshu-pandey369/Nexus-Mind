PORT=8001
NODE_ENV=development

# MongoDB Atlas connection URI for the auth database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/auth

# Must match the INTERNAL_SECRET in payment and agent services
# Generate: openssl rand -hex 32
INTERNAL_SECRET=

# Redis connection URL
# Local dev: redis://localhost:6379
# Docker:    redis://redis:6379
Redis_URL=redis://localhost:6379

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Firebase Admin SDK credentials (choose one method):
#
# Method 1 — RECOMMENDED for Docker/production:
#   Set this to the full JSON content of your serviceAccountKey.json
#   FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
FIREBASE_SERVICE_ACCOUNT_JSON=

# Method 2 — Local development only:
#   Place serviceAccountKey.json in Services/auth/ directory.
#   It is excluded from Docker images and git via .dockerignore and .gitignore.
