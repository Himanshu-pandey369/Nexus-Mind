# Frontend Environment Variables (Client-Safe ONLY - Never put private secrets here)
# Firebase Client API Key
VITE_FIREBASE_API=your_firebase_web_api_key_here

# Backend API Gateway Base URL (Must use HTTPS in production)
VITE_SERVER_URL=https://api.your-nexusmind-domain.com

# Razorpay Public Key ID ONLY (Never put RAZORPAY_KEY_SECRET here)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
